    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.4.6",
    "typescript": "^5.0.0"
  }
