# PostgreSQL connection string for local development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rabto

# Generate a unique random secret (at least 32 characters) for sessions and rate-limit HMAC keys.
SESSION_SECRET=replace-with-a-unique-random-secret-at-least-32-characters

# Exact number of trusted reverse proxies. Leave empty unless verified; do not guess.
TRUSTED_PROXY_HOPS=

# Optional public resolver origin (origin only, e.g. https://resolver.example.com).
# Leave empty to use same-origin relative links (/d/<code>).
NEXT_PUBLIC_RESOLVER_BASE_URL=
